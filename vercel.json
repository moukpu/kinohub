{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 300,
      "memory": 1024,
      "regions": ["fra1"]
    }
  },
  "rewrites": [
    {
      "source": "/movie/:id",
      "destination": "/movie.html?id=:id"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
